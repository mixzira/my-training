generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id        String    @id @default(cuid())
  nickname  String
  avatarKey String?
  heightCm  Int?
  weightKg  Float?
  birthDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  imageKey  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises Exercise[]
}

model Exercise {
  id         String   @id @default(cuid())
  name       String
  videoKey   String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]
  sessionEntries   SessionEntry[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Workout {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises    WorkoutExercise[]
  routineSlots RoutineSlot[]
  sessions     WorkoutSession[]
}

model Routine {
  id            String    @id @default(cuid())
  name          String
  startDate     DateTime  @default(now())
  currentSlotId String?   @unique
  currentSince  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  currentSlot RoutineSlot?   @relation("CurrentSlot", fields: [currentSlotId], references: [id], onDelete: SetNull)
  slots       RoutineSlot[]  @relation("RoutineSlots")
  logs        ExecutionLog[]
}

model RoutineSlot {
  id        String  @id @default(cuid())
  routineId String
  position  Int
  type      String
  workoutId String?

  routine          Routine        @relation("RoutineSlots", fields: [routineId], references: [id], onDelete: Cascade)
  workout          Workout?       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  currentOfRoutine Routine?       @relation("CurrentSlot")
  logs             ExecutionLog[]

  @@index([routineId])
  @@index([workoutId])
}

model ExecutionLog {
  id        String   @id @default(cuid())
  routineId String
  slotId    String
  date      DateTime @default(now())
  status    String

  routine Routine     @relation(fields: [routineId], references: [id], onDelete: Cascade)
  slot    RoutineSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([slotId])
}

model WorkoutSession {
  id          String    @id @default(cuid())
  date        DateTime  @unique
  workoutId   String
  completedAt DateTime?
  photoKey    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workout Workout        @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  entries SessionEntry[]

  @@index([workoutId])
}

model SessionEntry {
  id         String  @id @default(cuid())
  sessionId  String
  position   Int
  exerciseId String
  done       Boolean @default(false)
  weight     Float   @default(0)

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([exerciseId])
}

model WorkoutExercise {
  id         String @id @default(cuid())
  workoutId  String
  exerciseId String
  position   Int

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([workoutId])
  @@index([exerciseId])
}
