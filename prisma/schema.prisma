generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  imageKey  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises Exercise[]
}

model Exercise {
  id         String   @id @default(cuid())
  name       String
  videoKey   String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Workout {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises    WorkoutExercise[]
  routineSlots RoutineSlot[]
}

model Routine {
  id            String    @id @default(cuid())
  name          String
  currentSlotId String?   @unique
  currentSince  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  currentSlot RoutineSlot?   @relation("CurrentSlot", fields: [currentSlotId], references: [id], onDelete: SetNull)
  slots       RoutineSlot[]  @relation("RoutineSlots")
  logs        ExecutionLog[]
}

model RoutineSlot {
  id        String  @id @default(cuid())
  routineId String
  position  Int
  type      String
  workoutId String?

  routine          Routine        @relation("RoutineSlots", fields: [routineId], references: [id], onDelete: Cascade)
  workout          Workout?       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  currentOfRoutine Routine?       @relation("CurrentSlot")
  logs             ExecutionLog[]

  @@index([routineId])
  @@index([workoutId])
}

model ExecutionLog {
  id        String   @id @default(cuid())
  routineId String
  slotId    String
  date      DateTime @default(now())
  status    String

  routine Routine     @relation(fields: [routineId], references: [id], onDelete: Cascade)
  slot    RoutineSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([slotId])
}

model WorkoutExercise {
  id         String @id @default(cuid())
  workoutId  String
  exerciseId String
  position   Int

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([workoutId])
  @@index([exerciseId])
}
